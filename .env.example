# VinuFinance-Backend production deploy environment.
# Copy to .env and fill in real values. NEVER commit a real .env (it is gitignored).
#
# Used by: hardhat.config.ts (vinuchain network) + scripts/deploy.prod.ts
# Deploy with: yarn hardhat run scripts/deploy.prod.ts --network vinuchain

# ---- network + signer (consumed by hardhat.config.ts) ----
# RPC endpoint for VinuChain mainnet (chainId 207). Defaults to the public RPC if unset.
VINUCHAIN_RPC_URL=https://rpc.vinuchain.org
# RPC endpoint for VinuChain testnet (chainId 206), used by --network vinuchainTestnet.
VINUCHAIN_TESTNET_RPC_URL=https://vinufoundation-rpc.com
# Private key (no 0x prefix needed by ethers) of the funded deployer EOA. KEEP SECRET.
PRIVATE_KEY=

# ---- required addresses (no defaults; deploy aborts if missing/placeholder) ----
# Loan currency token (ERC20). Example (USDT on VinuChain): 0xC0264277fcCa5FCfabd41a8bC01c1FcAF8383E41
LOAN_CCY_TOKEN=
# Collateral currency token (ERC20). Example (WVC): 0xEd8c5530a0A086a12f57275728128a60DFf04230
COLL_CCY_TOKEN=
# Governance vote token (ERC20). Example (VINU): 0x00c1E515EA9579856304198EFb15f525A0bb50f6
VOTE_TOKEN=
# Veto holder for the Controller. Use a multisig in production (transfer later if bootstrapped from an EOA).
VETO_HOLDER=
# Emergency escrow address recorded in deployments/vinuchain.json for EmergencyWithdrawal wiring.
EMERGENCY_ESCROW=

# ---- REQUIRED economic params (loan-token-decimal-dependent; NO defaults) ----
# WARNING: every value below is in the LOAN TOKEN's raw base units, so the correct
# magnitude DEPENDS ON THE LOAN TOKEN'S DECIMALS. A baked default is unsafe and could
# mis-collateralize the pool (BasePool.loanTerms: loan ≈ pledge * maxLoanPerColl /
# 10**collTokenDecimals). The deploy ABORTS if any of these is unset.
#
# These are intentionally LEFT BLANK below: copying this template to .env must NOT
# silently satisfy the presence check with stale economics for the wrong token. You
# MUST fill each one in. The worked examples in the comments are for the documented
# USDT(6) loan / WVC(18) collateral pool — RECOMPUTE every value for any other loan token.

# 0.5 USDT lent per 1 whole WVC  (0.5 * 10**6 = 500000)
MAX_LOAN_PER_COLL=
# 10,000 USDT  (10000 * 10**6 = 10000000000)
LIQUIDITY_BND_1=
# 100,000 USDT (100000 * 10**6 = 100000000000); must be > LIQUIDITY_BND_1
LIQUIDITY_BND_2=
# 100 USDT     (100 * 10**6 = 100000000)
MIN_LOAN=
# 1,000 USDT   (1000 * 10**6 = 1000000000); must be >= 1000
MIN_LIQUIDITY=

# ---- pool policy params (optional; decimal-INDEPENDENT defaults in scripts/deploy.prod.ts) ----
# Collateral token decimals (integer). Default: 18
# COLL_TOKEN_DECIMALS=18
# Loan tenor in seconds. Default: 2592000 (30 days). Must be >= 86400 (1 day).
# LOAN_TENOR=2592000
# Interest rate params as human decimals (1e18-scaled by the script). Require R1 > R2 > 0.
# The deploy pre-flight also bounds R1 * LIQUIDITY_BND_1 so the MIN_LOAN quote's
# worst-case repayment fits BasePool's uint128 loan accounting.
# Defaults: 0.15 / 0.02
# R1=0.15
# R2=0.02
# Creator fee as human decimal (1e18-scaled). Capped at 0.03 (300bps). Default: 0.01 (1%)
# CREATOR_FEE=0.01
# Reward coefficient as human decimal (1e18-scaled, uint96). Default: 1.0
# REWARD_COEFFICIENT=1.0

# ---- governance params for Controller (optional; defaults shown) ----
# Thresholds out of 10000 (THRESHOLD_BASE). Each must be in (0, 10000]. Defaults: 5000 (50%)
# PAUSE_THRESHOLD=5000
# UNPAUSE_THRESHOLD=5000
# WHITELIST_THRESHOLD=5000
# DEWHITELIST_THRESHOLD=5000
# Seconds between token snapshots (> 0). Default: 86400 (1 day)
# SNAPSHOT_TOKEN_EVERY=86400
# Vote-token lock period in seconds. Default: 604800 (7 days)
# CONTROLLER_LOCK_PERIOD=604800
