  "scripts": {
    "test_legacy": "./node_modules/.bin/mocha --full-trace --config ./test/mocharc.nightly.json",
    "preprocess": "npx ts-node scripts/preprocess_for_tests.ts",
    "test": "TS_NODE_FILES=true && npm run preprocess && npx hardhat test",
    "coverage": "TS_NODE_FILES=true && npm run preprocess && npx hardhat coverage",
    "test:foundry": "forge test --match-path \"test/foundry/*.t.sol\" -vv",
    "reconcile:legacy": "node scripts/reconcile-legacy.mjs",
    "test:reconcile:legacy": "node scripts/reconcile-legacy.test.mjs",
    "verify:compiler": "npx hardhat clean && npx hardhat compile --force && forge build --force && forge config --json > /tmp/vinufinance-forge-config.json && node scripts/verify_compiler_alignment.js /tmp/vinufinance-forge-config.json"
  }
